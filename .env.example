# Copiez ce fichier en .env. Tout le reste se règle dans /admin.

# Comptes autorisés à ouvrir la page d'administration (logins AD, séparés par des virgules).
ADMIN_USERS=jpthony

# Méthode de connexion : kerberos | proxy_header | dev
AUTH_MODE=kerberos
# Pour un premier essai sans Kerberos, utilisez AUTH_MODE=dev et DEV_USER=votre_login
# DEV_USER=jpthony

# Facultatif : principal de service attendu (sinon toute clé du keytab est acceptée)
# KRB_SERVICE_PRINCIPAL=HTTP@assistance.local.lan

# Facultatif : clé de signature des sessions (sinon générée et conservée dans /data)
# SECRET_KEY=

LOG_LEVEL=INFO

# Les variables suivantes, si elles sont définies, priment sur l'admin et y apparaissent verrouillées.
# GLPI_URL=https://support.local.lan
# GLPI_APP_TOKEN=
# GLPI_USER_TOKEN=
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://llm.local.lan/v1
# LLM_MODEL=
# LLM_API_KEY=
